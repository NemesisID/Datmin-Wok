# Aplikasi
APP_NAME=Rekomendasi Pembimbing Skripsi
DATABASE_PATH=data/app.db

# OpenAlex. API key opsional, disarankan. Dikirim lewat header Authorization.
OPENALEX_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org

# Jendela publikasi yang diambil, dalam tahun.
PUBLICATION_WINDOW_YEARS=3

# Scraper HTML Scholar: jangan dinyalakan di produksi.
ENABLE_SCHOLAR_SCRAPER=false

# Admin. Satu akun bersama, tanpa tabel admin.
ADMIN_USERNAME=admin
# Buat dengan: uv run python -m app.cli hash-password
ADMIN_PASSWORD_HASH=
# Wajib diisi di produksi. Kosong berarti kunci acak dan sesi hilang saat restart.
SECRET_KEY=
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Klasifikasi Tahap 3 (opsional).
USE_LLM=false
LLM_PROVIDER=
LLM_MODEL=
