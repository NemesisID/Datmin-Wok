# Aplikasi
APP_NAME=Rekomendasi Pembimbing Skripsi
DATABASE_PATH=data/app.db

# OpenAlex. API key opsional, disarankan. Dikirim lewat header Authorization.
OPENALEX_API_KEY=
OPENALEX_BASE_URL=https://api.openalex.org

# Jendela publikasi yang diambil, dalam tahun.
PUBLICATION_WINDOW_YEARS=3
# Parameter rekomendasi. Tidak ditampilkan sebagai angka ke mahasiswa.
RECENCY_HALF_LIFE_YEARS=2
THESIS_LAMBDA=1.5
STALE_DAYS=90

# Backup SQLite. Jalankan: uv run python -m app.cli backup
BACKUP_DIR=data/backups
BACKUP_DAILY_KEEP=7
BACKUP_MONTHLY_KEEP=1

# Scraper HTML Scholar: jangan dinyalakan di produksi.
ENABLE_SCHOLAR_SCRAPER=false

# Admin. Satu akun bersama, tanpa tabel admin.
ADMIN_USERNAME=admin
# Buat dengan: uv run python -m app.cli hash-password
ADMIN_PASSWORD_HASH=
# Wajib diisi di produksi. Kosong berarti kunci acak dan sesi hilang saat restart.
SECRET_KEY=
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Klasifikasi Tahap 3 (opsional). Default mati: aturan saja.
USE_LLM=false
# openai (OpenAI-compatible) atau ollama.
LLM_PROVIDER=
LLM_MODEL=
# OpenAI-compatible: https://api.openai.com/v1. Ollama: http://127.0.0.1:11434.
LLM_BASE_URL=
# Hanya untuk provider OpenAI-compatible. Tidak pernah masuk log.
LLM_API_KEY=
LLM_BATCH_SIZE=20
LLM_TIMEOUT_SECONDS=30
